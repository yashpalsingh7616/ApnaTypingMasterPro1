rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Steno dictation audio: anyone can listen (students, visitors),
    // but only the logged-in admin can upload/replace/delete.
    match /stenoAudio/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yashpalsingh7616@gmail.com';
    }

    // Steno PDFs: anyone can view/download the PDF, but only the
    // logged-in admin can upload/delete.
    match /stenoPdfs/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yashpalsingh7616@gmail.com';
    }

    // Everything else stays locked to the logged-in admin only (safe default).
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'yashpalsingh7616@gmail.com';
    }
  }
}
